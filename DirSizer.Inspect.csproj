<Project Sdk="Microsoft.NET.Sdk">
  <!-- dirsizer-inspect.exe: read-only inspection of the NTFS master file table. For investigating and developing. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>dirsizer-inspect</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Speed</OptimizationPreference>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="InspectProgram.cs" />
    <Compile Include="RecordInspector.cs" />
    <Compile Include="RunList.cs" />
    <Compile Include="InspectSelfTests.cs" />
    <Compile Include="RecordDiff.cs" />
    <Compile Include="ConsolePause.cs" />
    <Compile Include="DriveRoot.cs" />
    <Compile Include="BulkReader.cs" />
    <Compile Include="BulkStability.cs" />
    <Compile Include="BulkScanner.cs" />
    <Compile Include="BulkReport.cs" />
    <ProjectReference Include="DirSizer.Core.csproj" />
  </ItemGroup>
</Project>
