<Project>
  <!-- Every project builds into artifacts\ (artifacts\bin\<project>\<configuration>_<runtime>\, artifacts\obj\<project>\, ...), so the
       tools no longer share one output folder and their intermediate files cannot overwrite each other. -->
  <PropertyGroup>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <!-- One version for every tool; scripts\release.ps1 reads it from here. -->
    <Version>0.7.0</Version>
  </PropertyGroup>
</Project>
