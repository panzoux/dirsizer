<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>0.3.0-p3</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Speed</OptimizationPreference>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <BaseOutputPath>bin\Bulk\</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Program.cs;SelfTests.cs" />
    <Compile Include="BulkProgram.cs" />
    <Compile Include="BulkReader.cs" />
    <Compile Include="BulkStability.cs" />
    <Compile Include="BulkScanner.cs" />
    <Compile Include="BulkReport.cs" />
    <Compile Include="BulkSelfTests.cs" />
    <ProjectReference Include="DirSizer.Core.csproj" />
  </ItemGroup>
</Project>
