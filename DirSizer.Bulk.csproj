<Project Sdk="Microsoft.NET.Sdk">
  <!-- dirsizer-bulk.exe: the same folder-size scan reading the raw $MFT in large blocks. Experimental. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>dirsizer-bulk</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>none</DebugType>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Speed</OptimizationPreference>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <!-- The only build that contains the test-only environment-variable hooks (see BulkIntegration.cs). Never used for a release. -->
  <PropertyGroup Condition="'$(Configuration)' == 'TestHooks'">
    <DefineConstants>$(DefineConstants);DIRSIZER_TEST_HOOKS</DefineConstants>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="BulkCliProgram.cs" />
    <Compile Include="BulkIntegration.cs" />
    <Compile Include="BulkReader.cs" />
    <Compile Include="BulkStability.cs" />
    <Compile Include="BulkScanner.cs" />
    <Compile Include="BulkReport.cs" />
    <Compile Include="BulkSelfTests.cs" />
    <Compile Include="ConsolePause.cs" />
    <Compile Include="Cli.cs" />
    <Compile Include="DriveRoot.cs" />
    <Compile Include="SelfTests.cs" />
    <ProjectReference Include="DirSizer.Core.csproj" />
  </ItemGroup>
</Project>